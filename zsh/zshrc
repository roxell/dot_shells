###############################################################################
# Anders' personal Zsh settings file
#
# Most recent update: 2006-04-23 16:28:35
###############################################################################

# Zsh and Bash config directory
Z=$HOME/.zsh
SH=$HOME/.shell

source $SH/environment.sh
source $SH/aliases.sh
source $SH/functions.sh

source $Z/environment.zsh
source $Z/functions.zsh
source $Z/options.zsh
source $Z/setup_colors.zsh
source $Z/prompt.zsh
source $Z/keybindings.zsh
source $Z/completion.zsh

# Agent commands for git rvw: git rvw review -- "${rw[@]}"
ro=(claude -p --restricted --strict-mcp-config
    --plugin-dir ~/local-etc/dot_ai/agents/rvw-plugin
    --tools Read,Grep,Glob,Skill
    --append-system-prompt-file ~/local-etc/dot_ai/agents/AGENTS.md)
rw=(claude -p --restricted --strict-mcp-config
    --plugin-dir ~/local-etc/dot_ai/agents/rvw-plugin
    --tools Read,Edit,Grep,Glob,Skill
    --permission-mode acceptEdits
    --append-system-prompt-file ~/local-etc/dot_ai/agents/AGENTS.md)

##############################################################################
# vim: expandtab tabstop=4 shiftwidth=4 softtabstop=4                        :

. "$HOME/.local/bin/env"
